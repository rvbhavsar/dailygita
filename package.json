{
  "name": "dailygita",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "node dist/server/index.js",
    "generate": "npm run generate --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "@swc/core@1.15.46": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}

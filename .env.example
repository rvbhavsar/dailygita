# Postgres connection string.
# Local:   postgresql://<you>@localhost:5432/dailygita
# Railway: reference the Postgres plugin -> ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user@localhost:5432/dailygita

# Signing key for session JWTs. Must be at least 32 characters.
# Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-min-32

# Public origin, used to build password-reset links.
# Local: http://localhost:5173   Railway: https://<your-app>.up.railway.app
APP_URL=http://localhost:5173

PORT=3001
NODE_ENV=development

# Optional. Without it, password-reset links are logged to the server console
# instead of emailed, which is fine for local development.
# RESEND_API_KEY=
# RESEND_FROM=DailyGita <noreply@yourdomain.com>

# Meta Model API (api.meta.ai/v1) — personalized insights.
# Without it, /api/insights/personalized returns 501.
# META_API_KEY=

# Deepgram — English narration. Without it, narration returns 501 and only
# the Sanskrit recitation is offered.
# DEEPGRAM_API_KEY=

# Where generated narration mp3s are cached. On Railway this is a mounted volume.
AUDIO_DIR=/data/audio
